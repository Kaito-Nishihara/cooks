{
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(npm run *:*)",
      "Bash(npx drizzle-kit *:*)",
      "Bash(npx wrangler d1 migrations list *:*)",
      "Bash(npx tsc *:*)",
      "Bash(npx vitest *:*)",
      "Bash(npx playwright *:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add *:*)",
      "Bash(git commit *:*)",
      "Bash(git checkout *:*)",
      "Bash(git push *:*)",
      "Bash(gh pr *:*)",
      "Bash(gh issue *:*)",
      "Bash(grep *:*)",
      "Bash(cd *:*)"
    ],
    "ask": [
      "Bash(*wrangler deploy*)",
      "Bash(*--remote*)",
      "Bash(*wrangler d1 execute*)",
      "Bash(*wrangler r2 *delete*)",
      "Bash(docker compose down -v:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"=== 型検査: docker compose exec app npx tsc --noEmit ===\""
          }
        ]
      }
    ]
  }
}

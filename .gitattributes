# コンテナの中で動かすスクリプトは、Windows で取り出しても改行を LF に保つ。
# CRLF になると、Linux のシェルが行末の文字を命令の一部として読み、動かなくなる。
*.sh text eol=lf
deploy/tools/bin/* text eol=lf
Dockerfile text eol=lf
deploy/**/*.yaml text eol=lf
pom.xml text eol=lf
*.java text eol=lf
*.properties text eol=lf
services/**/*.yaml text eol=lf
*.sql text eol=lf
# 目録の 1 品のファイルは、Windows で取り出しても LF に保つ
recipes/catalog/*.json text eol=lf
scripts/*.mjs text eol=lf
